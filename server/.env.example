# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/gurjeets_handcraft

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# Initial Artisan Admin Credentials (for seed script)
# [PLACEHOLDER - Gurjeet can update this with her real admin email and secure password]
ADMIN_NAME=your_admin_name
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_admin_password_here

# Cloudinary (Image Hosting)
# [PLACEHOLDER - Replace with your Cloudinary credentials from cloudinary.com console]
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Centralized Business & WhatsApp Configuration
BUSINESS_PHONE=1234567891
BUSINESS_WHATSAPP=91234567891

